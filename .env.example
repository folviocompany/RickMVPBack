APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adi

LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_OCR_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

FRONTEND_ORIGINS=http://localhost:5173
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20

EXTRACTA_ALLOW_EXTERNAL_AI=false
EXTRACTA_OCR_DPI=300
EXTRACTA_OCR_LANG=por+eng
EXTRACTA_TESSERACT_CMD=tesseract
EXTRACTA_TESSDATA_DIR=data/tessdata
EXTRACTA_SAMPLES_DIR=samples/atacadao
EXTRACTA_RESULTS_DIR=data/extracta
EXTRACTA_STORAGE=postgres
EXTRACTA_MAX_LLM_CALLS_PER_DOCUMENT=3
EXTRACTA_MAX_LLM_CALLS_PER_BATCH=9
EXTRACTA_MAX_RETRIES=1
EXTRACTA_LLM_TIMEOUT_SECONDS=20
EXTRACTA_LLM_DEADLINE_SECONDS=45
EXTRACTA_LLM_MAX_INPUT_CHARS=7000
EXTRACTA_LLM_MAX_OUTPUT_TOKENS=1024
EXTRACTA_LLM_RESPONSE_FORMAT=json_object
EXTRACTA_MAX_PROCESSING_ATTEMPTS=3
EXTRACTA_MAX_PAGES_PER_DOCUMENT=30
EXTRACTA_MAX_DOCUMENTS_PER_BATCH=10
EXTRACTA_OCR_TIMEOUT_SECONDS=60

